# Copy to .env. "sample" replays the offline synthetic fixture; "savant" pulls live data.
STATCAST_SOURCE=sample
# Comma-separated game types to pull: regular, postseason, spring.
STATCAST_GAME_TYPES=regular
# Scheduled runs re-pull this many trailing days so Savant's late corrections land.
STATCAST_REFRESH_DAYS=3
# Where the loader and dbt write. Leave unset for the Postgres in Docker Compose;
# point at a managed Postgres (e.g. Neon) to feed the Cloudflare site through Hyperdrive.
# WAREHOUSE_HOST=ep-xxx.us-east-2.aws.neon.tech
# WAREHOUSE_PORT=5432
# WAREHOUSE_DB=statcast
# WAREHOUSE_USER=statcast
# WAREHOUSE_PASSWORD=
# WAREHOUSE_SSLMODE=require
