{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stat-cast",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Served at statcast.tuckers.solutions (zone tuckers.solutions is on this account);
  // the workers.dev URL stays on for previews.
  "workers_dev": true,
  "routes": [{ "pattern": "statcast.tuckers.solutions", "custom_domain": true }],
  "hyperdrive": [
    {
      // The warehouse: Hyperdrive config "stat-cast" in front of the Neon project
      // the pipeline loads into (created in the Cloudflare dashboard).
      "binding": "HYPERDRIVE",
      "id": "0ed507c6291344b0a256c380caf801dc",
      // Used by `wrangler dev` / `npm run preview`: the Docker Compose warehouse.
      "localConnectionString": "postgres://statcast:statcast@localhost:5432/statcast"
    }
    // Optional: Airflow's metadata DB, for the DAG run grid in the pipeline panel.
    // { "binding": "AIRFLOW_HYPERDRIVE", "id": "<id>", "localConnectionString": "postgres://airflow:airflow@localhost:5432/airflow" }
  ]
}
